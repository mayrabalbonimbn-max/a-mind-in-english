PORT=3000
NODE_ENV=development
# Use an isolated local/dev database. Never put production credentials in this file.
DATABASE_URL="postgresql://localhost:5432/amindinenglish_dev"
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
CORS_ORIGIN="http://localhost:3000"
ALLOW_REGISTRATION=true

# AI (OpenAI). Leave AI_API_KEY empty and the app works without AI features.
AI_PROVIDER=openai
AI_API_KEY=
# One model per AI function. There is NO global fallback: an empty model disables only that
# function (it answers 503), so a cheap model is never silently replaced by an expensive one.
AI_MODEL_EXPLAIN=
AI_MODEL_LISTENING=
AI_MODEL_OUTLINE=
AI_MODEL_WRITING=
AI_MODEL_SPEAKING_FEEDBACK=
AI_MODEL_TEACHER_LENS=
AI_MODEL_LIGHT_LANGUAGE=
AI_MODEL_INTERPRET_ITEM=
AI_MODEL_EXPLAIN_QUESTION=
AI_MODEL_CHARACTER_CHAT=
AI_MODEL_CONVERSATION_HELP=
AI_MODEL_CONVERSATION_REVIEW=
# Compare registers (selected text → five registers). Intended: gpt-5.4-nano with reasoning none
AI_MODEL_REGISTER_COMPARE=
AI_MODEL_MAIN_WRITE=
AI_MODEL_NIGHTLY_LEARNING_REVIEW=
# Reasoning effort per function: none | minimal | low | medium | high. Set it explicitly for
# reasoning models (empty = not sent = the model's own, usually costlier, default).
AI_REASONING_EXPLAIN=
AI_REASONING_LISTENING=
AI_REASONING_OUTLINE=
AI_REASONING_WRITING=
AI_REASONING_SPEAKING_FEEDBACK=
AI_REASONING_TEACHER_LENS=
AI_REASONING_LIGHT_LANGUAGE=
AI_REASONING_INTERPRET_ITEM=
AI_REASONING_EXPLAIN_QUESTION=
AI_REASONING_CHARACTER_CHAT=
AI_REASONING_CONVERSATION_HELP=
AI_REASONING_CONVERSATION_REVIEW=
AI_REASONING_REGISTER_COMPARE=
AI_REASONING_MAIN_WRITE=
AI_REASONING_NIGHTLY_LEARNING_REVIEW=
# Speaking transcription (verbatim, errors preserved). Default: whisper-1
AI_TRANSCRIPTION_MODEL=whisper-1
AI_TIMEOUT_MS=120000
AI_MAX_WRITING_CHARS=15000
AI_FEEDBACK_PER_HOUR=12
AI_EXPLAIN_PER_HOUR=60
AI_CHARACTER_CHAT_PER_HOUR=80
AI_CONVERSATION_HELP_PER_HOUR=30
AI_CONVERSATION_REVIEW_PER_HOUR=8
AI_REGISTER_COMPARE_PER_HOUR=30
# Speaking transcriptions per user per hour (audio is the costliest AI call)
AI_TRANSCRIBE_PER_HOUR=20

# Learning Review (button + nightly job). The nightly job is off unless LEARNING_REVIEW_NIGHTLY=true,
# and even then it only runs for learners whose first review was started by hand.
LEARNING_REVIEW_PER_HOUR=4
LEARNING_REVIEW_TIMEOUT_MS=90000
LEARNING_REVIEW_MAX_OUTPUT_TOKENS=3500
LEARNING_REVIEW_MAX_ITEMS=60
LEARNING_REVIEW_NIGHTLY=false
